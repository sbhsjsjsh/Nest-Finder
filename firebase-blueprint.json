{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A property inquiry from a potential buyer.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the lead", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "phone": { "type": "string", "pattern": "^[0-9]{10}$", "description": "10-digit phone number" },
        "propertyType": { "type": "string", "enum": ["Apartment", "Villa / Bungalow", "Office Space", "Shop / Showroom", "Land / Plot"] },
        "bhk": { "type": "string", "enum": ["1 BHK", "2 BHK", "3 BHK", "4 BHK", "5+ BHK"] },
        "budget": { "type": "string", "description": "Budget range" },
        "locality": { "type": "string", "description": "Preferred locality" },
        "purpose": { "type": "string", "enum": ["Self Use", "Investment"] },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the inquiry was made" }
      },
      "required": ["name", "email", "phone", "propertyType", "budget", "locality", "purpose", "timestamp"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of all property inquiries"
    }
  }
}
